{
  "compilerOptions": {
    /* Estrutura de pastas */
    "rootDir": "./",  //  era "./"
    "outDir": "./dist",

    /* Node.js + ESM (produção) */
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "target": "ES2020",

    "allowImportingTsExtensions": false,

    /* Interoperabilidade */
    "esModuleInterop": true,

    /* Tipagem */
    "types": ["node"],
    "strict": true,

    /* Build */
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "drizzle/**/*"],  //  removeu o drizzle/drizzle.ts (está fora do rootDir)
  "exclude": ["node_modules", "dist", "drizzle.config.ts"]
}
